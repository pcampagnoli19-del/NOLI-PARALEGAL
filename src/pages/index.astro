---
import DeadlineTable from '../components/DeadlineTable.astro';
import Ornament from '../components/Ornament.astro';
import PhotoBand from '../components/PhotoBand.astro';
import ServiceTable from '../components/ServiceTable.astro';
import { company, experience } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="NOLI Paralegal · Apoio paralegal em São Paulo"
  description="Abertura, alteração e regularização de empresas, do protocolo ao registro, na Junta Comercial, na Receita Federal, nas prefeituras e nos cartórios."
>
  <section class="hero container">
    <h1>Abertura, alteração e regularização de empresas, do protocolo ao registro.</h1>
    <p class="hero__text">
      Cuidamos do processo na Junta Comercial, na Receita Federal, nas prefeituras e nos
      cartórios. Você acompanha cada etapa e recebe o documento registrado.
    </p>
    <div class="actions">
      <a class="btn btn--solid" href="/contato">Solicitar proposta</a>
      <a class="btn" href={company.whatsappHref}>Falar pelo WhatsApp</a>
    </div>
    <DeadlineTable />
  </section>

  <PhotoBand />

  <section class="section container">
    <h2 class="section__title">O que fazemos</h2>
    <ServiceTable examples />
  </section>

  <Ornament />

  <section class="section container split">
    <div>
      <h2 class="section__title">Experiência</h2>
      <p class="split__text">{experience}</p>
      <p class="split__link">
        <a href="/atuacao-nacional">Ver as Juntas Comerciais em que atuamos</a>
      </p>
    </div>
    <div>
      <h2 class="section__title">Para quem</h2>
      <p class="split__text">
        Atendemos escritórios de contabilidade, escritórios de advocacia que delegam o
        expediente paralegal, departamentos jurídicos de empresas e empresários que precisam
        abrir, alterar ou regularizar uma empresa.
      </p>
    </div>
  </section>

  <section class="closing">
    <div class="container">
      <p class="closing__text">
        Mande a situação pelo WhatsApp ou pelo formulário. Respondemos em até um dia útil com
        o que precisa ser feito, o prazo e o custo.
      </p>
      <div class="actions">
        <a class="btn btn--solid" href="/contato">Solicitar proposta</a>
        <a class="btn" href={company.whatsappHref}>Falar pelo WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-5);
  }

  .hero h1 {
    max-width: 17em;
  }

  .hero__text {
    max-width: 36em;
    margin-top: var(--space-3);
  }

  .split {
    display: grid;
    gap: var(--space-5);
  }

  .split__text {
    max-width: 36em;
    margin-top: var(--space-3);
  }

  .split__link {
    margin-top: var(--space-2);
  }

  .split__link a {
    color: var(--navy);
    text-decoration-color: var(--gold);
  }

  .closing {
    padding-block: var(--space-5);
    border-top: 1px solid var(--rule);
    background: var(--paper);
  }

  .closing__text {
    max-width: 36em;
    color: var(--navy);
    font-family: var(--font-title);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: 1.35;
  }

  @media (min-width: 56rem) {
    .split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
</style>
