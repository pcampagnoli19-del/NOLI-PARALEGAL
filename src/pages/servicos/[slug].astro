---
import type { GetStaticPaths } from 'astro';
import DeadlineTable from '../../components/DeadlineTable.astro';
import LegalNotice from '../../components/LegalNotice.astro';
import Ornament from '../../components/Ornament.astro';
import { services, type Service } from '../../data/services';
import { contactHref } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (() =>
  services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const description = service.opening.split(/(?<=\.) /)[0];
const hasComplement = service.detail || service.note || service.closing;
---

<BaseLayout title={`${service.title} · Noli Paralegal`} description={description}>
  <section class="section container">
    <h1>{service.title}</h1>
    <p class="opening">{service.opening}</p>
    <div class="actions">
      <a class="btn btn--solid" href={contactHref({ servico: service.slug })}>Solicitar orçamento</a>
    </div>
    <DeadlineTable area={service.slug} />
  </section>

  <Ornament />

  <section class="section container">
    <h2 class="section__title">{service.listTitle}</h2>
    <ul class="items">
      {service.items.map((item) => <li>{item}</li>)}
    </ul>

    {
      hasComplement && (
        <div class="complement">
          {service.detail && (
            <p>
              <strong>{service.detail.label}</strong> {service.detail.text}
            </p>
          )}
          {service.note && <p class="note">{service.note}</p>}
          {service.closing && <p>{service.closing}</p>}
        </div>
      )
    }

    {
      service.slug === 'societario' && (
        <div class="complement">
          <h2 class="section__title">O que depende do órgão</h2>
          <p>
            O prazo de análise, eventuais exigências e as taxas oficiais dependem da Junta
            Comercial e dos demais órgãos envolvidos. A proposta indica o que é estimativa e o que
            depende de terceiros.
          </p>
          <p class="more">
            <a class="text-link" href="/servicos/societario/alteracao-contratual">
              Alteração contratual na JUCESP
            </a>
          </p>
        </div>
      )
    }

    <p class="coverage">
      Atuamos nas Juntas Comerciais em que já conduzimos processos. Nas demais, a
      disponibilidade é sob consulta. <a href="/atuacao-nacional">Ver atuação nacional</a>
    </p>

    <div class="actions">
      <a class="btn btn--solid" href={contactHref({ servico: service.slug })}>Solicitar orçamento</a>
    </div>

    {
      service.showLegalNotice && (
        <div class="notice">
          <LegalNotice />
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  h1 {
    max-width: 18em;
  }

  .opening {
    max-width: 38em;
    margin-top: var(--space-3);
  }

  .items {
    max-width: 44em;
    margin-top: var(--space-3);
  }

  .items li {
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--rule);
  }

  .complement {
    max-width: 38em;
    margin-top: var(--space-4);
  }

  .complement strong {
    color: var(--navy);
    font-weight: 600;
  }

  .complement h2 {
    margin-bottom: var(--space-2);
    font-size: var(--text-h3);
  }

  .more {
    margin-top: var(--space-2);
  }

  .coverage {
    max-width: 44em;
    margin-top: var(--space-4);
    color: var(--muted);
    font-size: var(--text-small);
  }

  .coverage a {
    color: var(--navy);
  }

  .note {
    color: var(--muted);
    font-size: 1rem;
    font-style: italic;
  }

  .notice {
    max-width: 44em;
    margin-top: var(--space-4);
    padding: var(--space-3);
    border: 1px solid var(--rule);
    border-top: 1px solid var(--gold);
    background: var(--paper);
  }
</style>
