---
import { company, footerLine, footerNav } from '../data/site';
import LegalNotice from './LegalNotice.astro';
import Logo from './Logo.astro';
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <Logo variant="ivory" layout="stacked" />
        <p class="site-footer__tagline">{company.tagline}</p>
      </div>

      <section aria-labelledby="footer-contato">
        <h2 id="footer-contato">Contato</h2>
        <ul>
          <li>{company.address}</li>
          <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
          <li>Telefone: <a href={company.phoneHref}>{company.phone}</a></li>
          <li>WhatsApp: <a href={company.whatsappHref}>{company.whatsapp}</a></li>
          <li>{company.hours}</li>
        </ul>
      </section>

      <nav aria-labelledby="footer-navegacao">
        <h2 id="footer-navegacao">Navegação</h2>
        <ul class="site-footer__links">
          {footerNav.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="site-footer__base">
      <p>{footerLine}</p>
      <LegalNotice />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-6) var(--space-5);
    background: var(--navy-deep);
    color: var(--ivory);
    font-size: 1rem;
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-5) var(--space-4);
  }

  .site-footer__tagline {
    margin-top: var(--space-3);
    max-width: 18rem;
  }

  .site-footer h2 {
    margin-bottom: var(--space-2);
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--gold);
    color: var(--ivory);
    font-family: var(--font-title);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .site-footer li + li {
    margin-top: 0.375rem;
  }

  .site-footer li {
    overflow-wrap: anywhere;
  }

  .site-footer__links {
    columns: 2;
    column-gap: var(--space-4);
  }

  .site-footer__links li {
    break-inside: avoid;
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
  }

  .site-footer__base {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    /* Reserva a área do botão de WhatsApp no fim da página */
    padding-right: 4rem;
    border-top: 1px solid var(--gold);
    font-size: var(--text-small);
    color: var(--rule);
  }

  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: 1fr 1.2fr 1.6fr;
    }
  }
</style>
