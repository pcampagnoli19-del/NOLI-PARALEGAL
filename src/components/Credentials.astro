---
import { credentials } from '../data/site';

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<section class="credentials" aria-label={label}>
  <ul class="container credentials__list">
    {
      credentials.map((item) => (
        <li>
          <strong class="lining">{item.value}</strong>
          <span>{item.caption}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .credentials {
    background: var(--navy);
    color: var(--ivory);
  }

  .credentials__list {
    display: grid;
    padding-block: var(--space-4);
  }

  li {
    display: grid;
    gap: 0.25rem;
    padding-block: var(--space-3);
  }

  li + li {
    border-top: 1px solid var(--gold);
  }

  strong {
    font-family: var(--font-title);
    font-size: clamp(1.875rem, 1.7rem + 0.6vw, 2.125rem);
    font-weight: 600;
    line-height: 1.15;
  }

  span {
    color: var(--rule);
    font-size: 1.0625rem;
    line-height: 1.4;
  }

  @media (min-width: 56rem) {
    .credentials__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* Legendas alinhadas mesmo se um número quebrar em duas linhas */
    li {
      grid-template-rows: 1fr auto;
      padding-block: var(--space-1);
      padding-inline: var(--space-3);
    }

    li:first-child {
      padding-left: 0;
    }

    li + li {
      border-top: 0;
      border-left: 1px solid var(--gold);
    }
  }
</style>
