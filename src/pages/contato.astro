---
import ContactForm from '../components/ContactForm.astro';
import { company } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const intro = 'Descreva sua demanda. Retornamos em até um dia útil.';
---

<BaseLayout title="Contato · NOLI Paralegal" description={intro}>
  <section class="section container">
    <h1>Fale com a NOLI</h1>
    <p class="intro">{intro}</p>

    <div class="contact">
      <ContactForm />

      <aside class="details" aria-label="Dados de contato">
        <dl>
          <div>
            <dt>Endereço</dt>
            <dd>
              {company.address}
              <a class="details__map" href={company.mapsHref}>Ver no Google Maps</a>
            </dd>
          </div>
          <div>
            <dt>E-mail</dt>
            <dd><a href={`mailto:${company.email}`}>{company.email}</a></dd>
          </div>
          <div>
            <dt>Telefone</dt>
            <dd><a class="lining" href={company.phoneHref}>{company.phone}</a></dd>
          </div>
          <div>
            <dt>WhatsApp</dt>
            <dd><a class="lining" href={company.whatsappHref}>{company.whatsapp}</a></dd>
          </div>
          <div>
            <dt>Horário</dt>
            <dd class="lining">{company.hours}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 38em;
    margin-top: var(--space-3);
  }

  .contact {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  .details {
    padding: var(--space-4) var(--space-3);
    border: 1px solid var(--rule);
    border-top: 1px solid var(--gold);
    background: var(--paper);
    align-self: start;
  }

  dl {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  dt {
    color: var(--gold-text);
    font-family: var(--font-caps);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
  }

  dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .details__map {
    display: block;
  }

  @media (min-width: 56rem) {
    .contact {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }
  }
</style>
