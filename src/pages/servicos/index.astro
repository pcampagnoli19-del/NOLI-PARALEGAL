---
import ServiceTable from '../../components/ServiceTable.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const intro =
  'Atuamos em seis áreas complementares. Cada uma pode ser contratada de forma avulsa, por ato, ou em regime de acompanhamento mensal.';
---

<BaseLayout title="Serviços · NOLI Paralegal" description={intro}>
  <section class="section container">
    <h1>Serviços</h1>
    <p class="intro">{intro}</p>
    <ServiceTable examples headingLevel={2} />
  </section>
</BaseLayout>

<style>
  h1 {
    max-width: 18em;
  }

  .intro {
    max-width: 38em;
    margin-top: var(--space-3);
  }
</style>
