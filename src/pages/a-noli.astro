---
import Ornament from '../components/Ornament.astro';
import RomanList from '../components/RomanList.astro';
import { experience } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const intro =
  'A NOLI Paralegal cuida do expediente societário, cartorial e cadastral de empresas e escritórios. Fica na Avenida Paulista, em São Paulo, e atende processos em todo o Brasil.';

const practices = [
  {
    numeral: 'I',
    text: 'Conferimos os dados contra o contrato social e o cadastro na Receita antes de protocolar, para evitar exigência.',
  },
  {
    numeral: 'II',
    text: 'Informamos prazo e custo, com as taxas oficiais, antes de começar.',
  },
  {
    numeral: 'III',
    text: 'Dados de clientes ficam restritos a quem precisa deles para o trabalho.',
  },
  {
    numeral: 'IV',
    text: 'Atos que exigem advogado são feitos por advogados parceiros.',
  },
];
---

<BaseLayout title="A NOLI · NOLI Paralegal" description={intro.split('. ')[0] + '.'}>
  <section class="section container">
    <h1>Sobre a NOLI</h1>
    <p class="intro">{intro}</p>
  </section>

  <Ornament />

  <section class="section container">
    <h2 class="section__title">Como trabalhamos</h2>
    <RomanList items={practices} />
  </section>

  <Ornament />

  <section class="section container">
    <h2 class="section__title">Experiência</h2>
    <p class="intro">{experience}</p>
    <p class="more"><a href="/atuacao-nacional">Ver as Juntas Comerciais em que atuamos</a></p>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 36em;
    margin-top: var(--space-3);
  }

  .more {
    margin-top: var(--space-2);
  }

  .more a {
    color: var(--navy);
    text-decoration-color: var(--gold);
  }
</style>
