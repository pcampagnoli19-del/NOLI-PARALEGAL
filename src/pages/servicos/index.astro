---
import ServiceGrid from '../../components/ServiceGrid.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const intro =
  'Atuamos em seis áreas complementares. Cada uma pode ser contratada de forma avulsa, por ato, ou em regime de acompanhamento mensal.';
---

<BaseLayout title="Serviços · NOLI Paralegal" description={intro}>
  <section class="section container">
    <span class="overline">SERVIÇOS</span>
    <h1>Do registro da empresa à matrícula do imóvel.</h1>
    <p class="intro">{intro}</p>
    <ServiceGrid examples headingLevel={2} />
  </section>
</BaseLayout>

<style>
  h1 {
    max-width: 18em;
    margin-top: var(--space-3);
  }

  .intro {
    max-width: 38em;
    margin-top: var(--space-3);
  }
</style>
