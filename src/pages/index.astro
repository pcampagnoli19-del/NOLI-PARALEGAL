---
import { company, contactHref, serviceAreas } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const audiences = [
  {
    title: 'Para contabilidades',
    text: 'Delegue abertura, alteração, baixa e regularização de empresas. Podemos avaliar uma demanda avulsa ou uma parceria para o expediente recorrente da sua carteira.',
    link: 'Ver soluções para contabilidades',
    href: '/para-contabilidades',
  },
  {
    title: 'Para escritórios de advocacia',
    text: 'Conte com apoio documental, certidões, diligências administrativas e acompanhamento de registros. Seu escritório conduz a atividade jurídica.',
    link: 'Ver soluções para advocacia',
    href: '/para-advocacia',
  },
  {
    title: 'Para empresas e empresários',
    text: 'Vai abrir uma empresa, mudar o contrato social ou resolver uma pendência? Conte sua situação. A Noli ajuda a identificar as etapas administrativas e acompanha o que for contratado.',
    link: 'Ver soluções para empresas',
    href: '/para-empresas',
  },
];

const steps = [
  {
    title: 'Entendemos sua demanda.',
    text: 'Você descreve a situação e indicamos as informações necessárias para avaliar o pedido.',
  },
  {
    title: 'Apresentamos a proposta.',
    text: 'Você recebe o escopo, os custos, as taxas oficiais aplicáveis e os prazos estimados antes de aprovar.',
  },
  {
    title: 'Executamos e acompanhamos.',
    text: 'Depois da aprovação, conduzimos as etapas contratadas e avisamos se o órgão solicitar alguma providência.',
  },
  {
    title: 'Entregamos os documentos.',
    text: 'Você recebe os registros e documentos previstos no escopo, com um resumo do que foi feito.',
  },
];
---

<BaseLayout
  title="Noli Paralegal · Apoio paralegal em São Paulo"
  description="Cuidamos de registros societários, certidões e procedimentos cartorários para contabilidades, escritórios de advocacia e empresas."
>
  <section class="hero container">
    <span class="kicker">Noli Paralegal · Apoio empresarial</span>
    <h1>Abertura, alteração e regularização de empresas, do protocolo ao registro.</h1>
    <p class="lead">
      Cuidamos de registros societários, certidões e procedimentos cartorários para
      contabilidades, escritórios de advocacia e empresas. Você acompanha as etapas e recebe
      os documentos previstos na proposta.
    </p>
    <div class="actions">
      <a class="btn btn--solid" href="/contato">Solicitar proposta</a>
      <a class="btn" href="/servicos">Conhecer os serviços</a>
    </div>
  </section>

  <section class="section section--tinted" aria-labelledby="publicos">
    <div class="container">
      <h2 class="section__title" id="publicos">Apoio paralegal para a sua rotina</h2>
      <ul class="audiences">
        {
          audiences.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <a class="text-link" href={item.href}>
                {item.link}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section container" aria-labelledby="servicos">
    <h2 class="section__title" id="servicos">O que podemos fazer por você</h2>
    <ul class="service-list">
      {
        serviceAreas.map((area) => (
          <li>
            <a href={area.href}>{area.label}.</a> {area.homeSummary}
          </li>
        ))
      }
    </ul>
    <p class="more"><a class="text-link" href="/servicos">Explorar todos os serviços</a></p>
  </section>

  <section class="section section--tinted" aria-labelledby="experiencia">
    <div class="container narrow">
      <h2 class="section__title" id="experiencia">Experiência em registros e rotinas empresariais</h2>
      <p class="lead">
        Atuamos em processos societários, cartorários e cadastrais. Consulte as Juntas
        Comerciais em que já conduzimos processos. A disponibilidade para outras localidades
        depende da demanda.
      </p>
      <p class="links">
        <a class="text-link" href="/a-noli">Conhecer a Noli</a>
        <a class="text-link" href="/atuacao-nacional">Consultar atuação nacional</a>
      </p>
    </div>
  </section>

  <section class="section container" aria-labelledby="como">
    <h2 class="section__title" id="como">Como trabalhamos</h2>
    <ol class="steps">
      {
        steps.map((step, index) => (
          <li>
            <span class="steps__number" aria-hidden="true">
              {index + 1}
            </span>
            <p>
              <strong>{step.title}</strong> {step.text}
            </p>
          </li>
        ))
      }
    </ol>
    <p class="more"><a class="text-link" href="/como-trabalhamos">Ver como trabalhamos</a></p>
  </section>

  <section class="section section--dark" aria-labelledby="modalidades">
    <div class="container narrow">
      <h2 id="modalidades">Por demanda ou em parceria recorrente</h2>
      <p class="lead">
        Para uma demanda específica, solicite uma proposta por serviço. Se seu escritório ou
        empresa tem uma rotina de registros, certidões ou acompanhamento, converse com a Noli
        sobre atendimento continuado.
      </p>
      <div class="actions">
        <a class="btn btn--light" href={contactHref({ tipo: 'pontual' })}>Solicitar proposta</a>
        <a class="btn btn--outline-light" href={contactHref({ tipo: 'recorrente' })}
          >Conversar sobre parceria</a
        >
      </div>
    </div>
  </section>

  <section class="section container narrow" aria-labelledby="grupo">
    <h2 class="section__title" id="grupo">Grupo Noli</h2>
    <p class="lead">
      A Noli Paralegal presta apoio a empresas e escritórios em rotinas societárias,
      documentais e registrais. A Legaas é uma iniciativa de tecnologia em desenvolvimento para
      a organização de rotinas profissionais.
    </p>
    <p class="more"><a class="text-link" href="/grupo-noli">Conhecer o Grupo Noli</a></p>
  </section>

  <section class="section section--tinted closing" aria-labelledby="conversar">
    <div class="container narrow">
      <h2 id="conversar">Vamos conversar sobre sua demanda?</h2>
      <p class="lead">
        Conte o que você precisa resolver. Com essas informações, avaliamos o pedido e
        indicamos os próximos passos para preparar uma proposta.
      </p>
      <div class="actions">
        <a class="btn btn--solid" href="/contato">Solicitar proposta</a>
        <a class="btn" href={company.whatsappHref}>Falar pelo WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-6);
  }

  .hero h1 {
    max-width: 18em;
  }

  .narrow > * {
    max-width: 48rem;
  }

  .section--tinted {
    background: var(--paper);
    border-block: 1px solid var(--rule);
  }

  .section--dark {
    background: var(--navy);
    color: var(--ivory);
  }

  .section--dark h2 {
    color: var(--ivory);
  }

  .audiences {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .audiences li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 2px solid var(--navy);
  }

  .audiences h3 {
    font-size: var(--text-h3);
  }

  .audiences .text-link {
    margin-top: auto;
  }

  .service-list {
    display: grid;
    margin-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .service-list li {
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--rule);
  }

  .service-list a {
    color: var(--navy);
    font-family: var(--font-title);
    font-weight: 700;
    text-decoration-color: var(--gold);
  }

  .more {
    margin-top: var(--space-3);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-3);
  }

  .steps {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .steps li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-2);
    align-items: start;
  }

  .steps__number {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-top-right-radius: 100%;
    background: var(--navy);
    color: var(--ivory);
    font-family: var(--font-title);
    font-weight: 700;
  }

  .steps strong {
    color: var(--navy);
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .audiences {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }
</style>
