---
import { company, serviceAreas } from '../data/site';

const endpoint: string = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ?? '';
const successMessage = 'Mensagem enviada. Retornamos em até um dia útil.';
const errorMessage = `Não foi possível enviar a mensagem. Tente novamente ou escreva para ${company.email}.`;
---

<form
  class="contact-form"
  method="post"
  action={endpoint || undefined}
  data-contact-form
  data-success={successMessage}
  data-error={errorMessage}
>
  <p class="contact-form__hint">* Campos obrigatórios</p>

  <div class="field">
    <label for="nome">Nome *</label>
    <input id="nome" name="nome" type="text" autocomplete="name" required />
  </div>

  <div class="field">
    <label for="empresa">Empresa/escritório</label>
    <input id="empresa" name="empresa" type="text" autocomplete="organization" />
  </div>

  <div class="contact-form__row">
    <div class="field">
      <label for="email">E-mail *</label>
      <input id="email" name="email" type="email" autocomplete="email" required />
    </div>

    <div class="field">
      <label for="telefone">Telefone</label>
      <input id="telefone" name="telefone" type="tel" autocomplete="tel" />
    </div>
  </div>

  <div class="field">
    <label for="area">Área *</label>
    <select id="area" name="area" required>
      <option value="" selected disabled></option>
      {serviceAreas.map((area) => <option value={area.label}>{area.label}</option>)}
      <option value="Outro">Outro</option>
    </select>
  </div>

  <div class="field">
    <label for="mensagem">Mensagem *</label>
    <textarea id="mensagem" name="mensagem" rows="6" required></textarea>
  </div>

  <div class="contact-form__trap" aria-hidden="true">
    <label for="gotcha">Não preencha este campo</label>
    <input id="gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="consent">
    <input id="privacidade" name="privacidade" type="checkbox" value="Aceito" required />
    <label for="privacidade">
      Li e concordo com a <a href="/privacidade" target="_blank" rel="noopener"
        >Política de Privacidade</a
      >
    </label>
  </div>

  <button class="btn btn--solid" type="submit">Enviar</button>

  <p class="contact-form__status" role="status" tabindex="-1" data-form-status></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-form-status]');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  const show = (message: string, isError: boolean) => {
    if (!status) return;
    status.textContent = message;
    status.classList.toggle('contact-form__status--error', isError);
    status.focus();
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const endpoint = form.getAttribute('action');
    const { success = '', error = '' } = form.dataset;

    if (!endpoint) {
      show(error, true);
      return;
    }

    if (button) button.disabled = true;
    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(String(response.status));
      form.reset();
      show(success, false);
    } catch {
      show(error, true);
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>

<style>
  .contact-form {
    display: grid;
    gap: var(--space-3);
  }

  .contact-form__hint {
    color: var(--muted);
    font-size: var(--text-small);
  }

  .contact-form__row {
    display: grid;
    gap: var(--space-3);
  }

  .field {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .field label {
    color: var(--navy);
    font-weight: 500;
  }

  input:not([type='checkbox']),
  select,
  textarea {
    width: 100%;
    min-height: 2.875rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--muted);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--navy);
    outline-offset: 1px;
  }

  .contact-form__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .consent {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: var(--space-1);
    align-items: start;
  }

  .consent input {
    width: 1.25rem;
    height: 1.25rem;
    margin: 0.25rem 0 0;
    accent-color: var(--navy);
  }

  .contact-form .btn {
    justify-self: start;
    min-width: 10rem;
  }

  .contact-form .btn:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  .contact-form__status {
    color: var(--navy);
    font-weight: 500;
  }

  .contact-form__status:empty {
    display: none;
  }

  .contact-form__status:focus {
    outline: none;
  }

  .contact-form__status--error {
    color: #8a1c1c;
  }

  @media (min-width: 40rem) {
    .contact-form__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
