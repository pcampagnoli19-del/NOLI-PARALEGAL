---
import { company, mainNav } from '../data/site';
import Logo from './Logo.astro';

const currentPath = Astro.url.pathname.replace(/\.html$/, '');
const isCurrent = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/" aria-label="NOLI Paralegal, página inicial">
      <Logo />
    </a>

    <nav class="site-nav" aria-label="Menu principal">
      <ul>
        {
          mainNav.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn site-header__cta" href="/contato">Solicitar proposta</a>

    <button class="menu-toggle" type="button" data-menu-open aria-haspopup="dialog">
      Menu
    </button>
  </div>

  <dialog class="drawer" data-menu aria-label="Menu">
    <div class="drawer__top">
      <Logo />
      <button class="menu-toggle" type="button" data-menu-close>Fechar</button>
    </div>

    <nav aria-label="Menu principal, versão móvel">
      <ul class="drawer__nav">
        {
          mainNav.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn--solid drawer__cta" href="/contato">Solicitar proposta</a>

    <ul class="drawer__contact">
      <li>Telefone: <a class="lining" href={company.phoneHref}>{company.phone}</a></li>
      <li>WhatsApp: <a class="lining" href={company.whatsappHref}>{company.whatsapp}</a></li>
    </ul>
  </dialog>
</header>

<script>
  const drawer = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  openButton?.addEventListener('click', () => drawer?.showModal());
  closeButton?.addEventListener('click', () => drawer?.close());

  // Clique no fundo escurecido fecha a gaveta
  drawer?.addEventListener('click', (event) => {
    if (event.target === drawer) drawer.close();
  });

  // Ao voltar para a largura de desktop, a gaveta não deve continuar aberta
  window.matchMedia('(min-width: 75rem)').addEventListener('change', (event) => {
    if (event.matches) drawer?.close();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ivory);
    border-bottom: 1px solid var(--gold);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--header-height);
  }

  .site-header__logo {
    margin-right: auto;
    text-decoration: none;
  }

  .site-nav {
    display: none;
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-3);
  }

  .site-nav a,
  .drawer__nav a {
    color: var(--navy);
    font-family: var(--font-caps);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-decoration: none;
  }

  .site-nav a {
    display: inline-block;
    padding-block: 0.25rem;
    border-bottom: 1px solid transparent;
    font-size: 1.0625rem;
    white-space: nowrap;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    border-bottom-color: var(--gold);
  }

  .site-header__cta {
    display: none;
    white-space: nowrap;
  }

  .menu-toggle {
    min-height: 2.75rem;
    padding: 0.25rem 1rem;
    border: 1px solid var(--navy);
    background: transparent;
    color: var(--navy);
    font-family: var(--font-caps);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    cursor: pointer;
  }

  .drawer {
    width: min(24rem, 100vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0 0 0 auto;
    padding: var(--space-3) var(--gutter);
    border: 0;
    border-left: 1px solid var(--gold);
    background: var(--ivory);
    color: var(--ink);
  }

  .drawer[open] {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .drawer::backdrop {
    background: rgb(11 23 41 / 0.6);
  }

  .drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .drawer__nav li {
    border-bottom: 1px solid var(--rule);
  }

  .drawer__nav a {
    display: block;
    padding-block: 0.875rem;
    font-size: 1.1875rem;
  }

  .drawer__nav a[aria-current='page'] {
    color: var(--gold-text);
  }

  .drawer__contact {
    display: grid;
    gap: var(--space-1);
    margin-top: auto;
    padding-top: var(--space-2);
    border-top: 1px solid var(--gold);
  }

  /* Menu completo + botão precisam de cerca de 1160px */
  @media (min-width: 75rem) {
    .site-nav {
      display: block;
    }

    .site-header__cta {
      display: inline-flex;
    }

    .menu-toggle {
      display: none;
    }
  }
</style>
