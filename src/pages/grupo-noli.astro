---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Grupo Noli · Noli Paralegal"
  description="Simplificar rotinas jurídicas e empresariais com serviços especializados e tecnologia acessível."
>
  <section class="section container narrow">
    <span class="kicker">Grupo Noli</span>
    <h1>Grupo Noli</h1>
    <p class="lead">
      Simplificar rotinas jurídicas e empresariais com serviços especializados e tecnologia
      acessível.
    </p>
  </section>

  <section class="section section--tinted">
    <div class="container units">
      <article>
        <h2>Noli Paralegal</h2>
        <p>
          A Noli Paralegal presta apoio a empresas e escritórios em rotinas societárias,
          documentais e registrais.
        </p>
        <p class="more"><a class="text-link" href="/servicos">Conhecer os serviços</a></p>
      </article>
      <article>
        <h2>Legaas</h2>
        <p>
          A Legaas é uma iniciativa de tecnologia em desenvolvimento para a organização de rotinas
          profissionais.
        </p>
        <p class="status">Em desenvolvimento</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow > * {
    max-width: 48rem;
  }

  .section--tinted {
    background: var(--paper);
    border-block: 1px solid var(--rule);
  }

  .units {
    display: grid;
    gap: var(--space-5);
  }

  .units article {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 2px solid var(--navy);
  }

  .units h2 {
    font-size: var(--text-h3);
  }

  .status {
    align-self: start;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-title);
    font-size: 0.875rem;
    font-weight: 700;
  }

  @media (min-width: 48rem) {
    .units {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
